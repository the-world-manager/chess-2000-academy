{
  "name": "chess-2000-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run prepare:engine && node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "npm run prepare:engine && tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:postgres": "tsx scripts/test-postgres.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:import-sqlite": "node --env-file-if-exists=.env --import tsx scripts/import-sqlite.ts",
    "prepare:engine": "tsx scripts/prepare-engine.ts",
    "test:live": "NODE_USE_ENV_PROXY=1 tsx scripts/test-live-chess.ts && playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stockfish": "19.0.1",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
