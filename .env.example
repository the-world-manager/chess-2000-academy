# Копируйте значения только в защищённые настройки среды, не коммитьте пароль.
# Без DATABASE_URL npm run dev использует прежнюю локальную SQLite.
# PostgreSQL/Neon:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# HOST=0.0.0.0
# COOKIE_SECURE=true
# OWNER_LOGIN=alexander
# OWNER_PASSWORD=придумайте-уникальный-пароль-не-короче-12-символов
